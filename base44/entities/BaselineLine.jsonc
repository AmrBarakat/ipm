{
  "name": "BaselineLine",
  "type": "object",
  "properties": {
    "baseline_id": {
      "type": "string",
      "description": "Reference to the CharterBaseline this line belongs to."
    },
    "project_id": {
      "type": "string",
      "description": "Reference to the Project (denormalized for filtering)."
    },
    "stream": {
      "type": "string",
      "enum": [
        "goods",
        "services",
        "support"
      ],
      "description": "Which revenue/cost stream this line belongs to."
    },
    "line_type": {
      "type": "string",
      "enum": [
        "revenue",
        "direct_cost",
        "indirect_cost"
      ],
      "description": "Whether this line is a revenue, direct cost, or indirect cost entry."
    },
    "description": {
      "type": "string",
      "description": "Line item description from the bid charter."
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Line amount, net of VAT, in the project currency."
    },
    "currency": {
      "type": "string",
      "default": "SAR"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "source_ref": {
      "type": "string",
      "description": "Reference to the source row/section in the charter document."
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "baseline_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_status": "approved"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "privilege": "create"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "privilege": "modify"
          }
        },
        {
          "user_condition": {
            "privilege": "create"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "privilege": "create"
          }
        }
      ]
    }
  }
}