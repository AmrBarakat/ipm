{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to the Project this conversation belongs to"
    },
    "title": {
      "type": "string",
      "description": "Short title for the conversation"
    },
    "kind": {
      "type": "string",
      "enum": [
        "schedule",
        "project"
      ],
      "default": "project",
      "description": "Which assistant owns this conversation. Existing conversations without a kind are treated as 'project' on read."
    }
  },
  "required": [
    "title"
  ]
}