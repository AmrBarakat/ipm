{
  "name": "Note",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "note_type": {
      "type": "string",
      "enum": [
        "plain",
        "po_summary",
        "dn_summary"
      ],
      "default": "plain",
      "description": "plain = free-text note; po_summary / dn_summary = structured table rendered from table_data"
    },
    "table_data": {
      "type": "object",
      "description": "Structured payload for summary notes (po_summary / dn_summary). Null for plain notes.",
      "properties": {
        "document_type": {
          "type": "string"
        },
        "document_number": {
          "type": "string"
        },
        "document_date": {
          "type": "string"
        },
        "vendor_name": {
          "type": "string"
        },
        "extraction_id": {
          "type": "string"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bom_item_id": {
                "type": "string"
              },
              "bom_description": {
                "type": "string"
              },
              "part_number": {
                "type": "string"
              },
              "erp_item_code": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "qty": {
                "type": "number"
              },
              "unit_price": {
                "type": "number"
              },
              "net_amount": {
                "type": "number"
              },
              "quoted_unit_price": {
                "type": "number"
              },
              "price_variance_pct": {
                "type": "number"
              },
              "matched": {
                "type": "boolean"
              },
              "match_confidence": {
                "type": "number"
              },
              "match_tier": {
                "type": "string"
              },
              "applied_status": {
                "type": "string"
              },
              "ocr_uncertain": {
                "type": "boolean"
              },
              "ordered_qty": {
                "type": "number"
              },
              "delivered_this_slip": {
                "type": "number"
              },
              "cumulative_delivered": {
                "type": "number"
              },
              "remaining": {
                "type": "number"
              },
              "action": {
                "type": "string"
              },
              "source_ref": {
                "type": "string"
              },
              "source_date": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "project_id",
    "body"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_status": "approved"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "privilege": "create"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "privilege": "modify"
          }
        },
        {
          "user_condition": {
            "privilege": "create"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "privilege": "create"
          }
        }
      ]
    }
  }
}