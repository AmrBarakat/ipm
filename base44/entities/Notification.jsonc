{
  "name": "Notification",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_code": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "default": "info"
    },
    "link": {
      "type": "string"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    },
    "snooze_until": {
      "type": "string",
      "format": "date-time",
      "description": "If set and in the future, hide the notification from the active feed until this time (postpone/snooze)."
    },
    "dismissed": {
      "type": "boolean",
      "default": false,
      "description": "Cleared/dismissed by the user; hidden from the active feed but retained for audit."
    }
  },
  "required": [
    "title"
  ]
}