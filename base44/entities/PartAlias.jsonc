{
  "name": "PartAlias",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Empty string = global alias, applies across all projects."
    },
    "normalized_code": {
      "type": "string",
      "description": "normalizeCode() output of the code as it appeared on the document, after ERP prefix stripping."
    },
    "raw_code": {
      "type": "string",
      "description": "The code exactly as printed, e.g. ES.Dell.KM3322W"
    },
    "erp_item_code": {
      "type": "string"
    },
    "bom_item_id": {
      "type": "string"
    },
    "manufacturer_part_number": {
      "type": "string",
      "description": "Canonical part this alias resolves to."
    },
    "description_sample": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "user_confirmed",
        "auto_high_confidence"
      ],
      "default": "user_confirmed"
    },
    "hit_count": {
      "type": "number",
      "default": 1
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "normalized_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "account_status": "approved"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "privilege": "create"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "privilege": "modify"
          }
        },
        {
          "user_condition": {
            "privilege": "create"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "privilege": "create"
          }
        }
      ]
    }
  }
}