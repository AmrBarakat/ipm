{
  "name": "Generate Invoice on Milestone Completion",
  "description": "When a milestone status changes to 'completed', automatically generate an invoice draft with BOM items and billable hours from WBS.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"completed\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Milestone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "generate_invoice_on_milestone_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "generateMilestoneInvoice",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "generateMilestoneInvoice"
  }
}