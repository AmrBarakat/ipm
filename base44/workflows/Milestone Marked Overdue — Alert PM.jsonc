{
  "name": "Milestone Marked Overdue \u2014 Alert PM",
  "description": "When a milestone's status changes to \"overdue\", create a delay notification in the project feed immediately.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"overdue\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Milestone"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "milestone_marked_overdue_alert_pm",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "alertMilestoneDelayed",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "alertMilestoneDelayed"
  }
}